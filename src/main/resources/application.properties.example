# ==============================================================
# Plantilla de Configuración - FútbolStats (Spring Boot)
# Copia este archivo como "application.properties" y coloca tus
# credenciales locales de MySQL.
# ==============================================================

spring.application.name=demo

# Configuración de Conexión a Base de Datos MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/sistema?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=tu_contraseña_aqui

# Hibernate / JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
